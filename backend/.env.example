# Required. backend/scripts/init_env.py fills this on first run.
JWT_SECRET=__GENERATED_BY_INIT_ENV__

# Required. Fernet key used to encrypt Codex config and auth contents in DB.
CODEX_CONFIG_SECRET=__GENERATED_BY_INIT_ENV__

# JWT token lifetime in days.
JWT_TTL_DAYS=30

# Admin account, required. Edit before first run; init_admin.py refuses to start
# while password is empty, shorter than 6 chars, or still equals the placeholder.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# SQLAlchemy async database URL.
DATABASE_URL=sqlite+aiosqlite:///./data/mira.sqlite

# Persistent backend data directory.
DATA_DIR=./data

# Runtime home, CLI, workspace, and temporary execution directory.
RUNTIME_DIR=./runtime

# Docker sandbox image used for Codex App Server calls.
RUNTIME_SANDBOX_IMAGE=mira-agent-runtime:latest

# Optional Docker network name for sandbox containers. Leave empty for Docker default networking.
RUNTIME_DOCKER_NETWORK=

# Sandbox resource limits for each Agent call.
RUNTIME_CONTAINER_MEMORY=2g
RUNTIME_CONTAINER_CPUS=2.0
RUNTIME_CONTAINER_PIDS_LIMIT=256

# JSON array of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]

# Python logging level.
LOG_LEVEL=INFO

# Maximum uploaded skill package size in bytes.
MAX_SKILL_SIZE_BYTES=10000000

# Maximum uploaded file size in bytes.
MAX_UPLOAD_BYTES=20000000

# Maximum serialized run input payload size in bytes.
MAX_INPUT_SIZE_BYTES=1000000

# Maximum ask_user resume text size in bytes.
MAX_RESUME_TEXT_BYTES=8192

# Warn when data + runtime directories exceed this size in bytes.
DISK_WARN_BYTES=5000000000
